      "section": "低酸素分圧域（PaO₂ 60mmHg以下）",
      "qa": [
        {
          "question": "安静時のヘモグロビン酸素飽和度と予想される血液酸素分圧〈PO₂〉の組合せで正しいのはどれか。1つ選べ。",
          "answer": "90% ── 60mmHg",
          "choices": {
            "a": "100% ── 90mmHg",
            "b": "90% ── 60mmHg",
            "c": "75% ── 30mmHg",
            "d": "60% ── 20mmHg",
            "e": "50% ── 10mmHg"
          },
          "correctAnswer": "B",
          "numChoices": 1,
          "code": "116B57"
        }
      ]
    },
