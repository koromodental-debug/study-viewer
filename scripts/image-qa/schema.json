{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImageAnnotation",
  "type": "object",
  "required": [
    "annotation_id",
    "question_id",
    "image_id",
    "image_relpath",
    "status",
    "finding_tags",
    "anatomy_tags",
    "modality_tags",
    "summary_ja",
    "evidence_text",
    "confidence",
    "updated_at"
  ],
  "properties": {
    "annotation_id": {
      "type": "string",
      "description": "Unique id, e.g. 118A10:118A10_1"
    },
    "question_id": {
      "type": "string",
      "pattern": "^[0-9]{3}[A-D][0-9]{1,3}$"
    },
    "image_id": {
      "type": "string"
    },
    "image_relpath": {
      "type": "string"
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "rejected"
      ]
    },
    "finding_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anatomy_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modality_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary_ja": {
      "type": "string"
    },
    "evidence_text": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_comment": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
