      "qa": [
        {
          "question": "唾液腺の基本構造は？",
          "answer": "腺房（唾液産生）と導管（唾液輸送）"
        },
        {
          "question": "漿液細胞が分泌するのは？",
          "answer": "漿液（サラサラ）、アミラーゼなどの酵素を含む"
        },
        {
          "question": "粘液細胞が分泌するのは？",
          "answer": "粘液（ネバネバ）、ムチンを含む"
        },
        {
          "question": "漿液半月とは？",
          "answer": "粘液腺房の端に漿液細胞が半月状に付着した構造"
        }
      ]
    },
