      "qa": [
        {
          "question": "3極誘導心電図の波形で心筋虚血時に異常がみられるのはどれか。1つ選べ。",
          "answer": "ST部分",
          "choices": {
            "a": "PQ間隔",
            "b": "QRS幅",
            "c": "QT間隔",
            "d": "RR間隔",
            "e": "ST部分"
          },
          "correctAnswer": "E",
          "numChoices": 1,
          "code": "113B65"
        },
        {
          "question": "健常成人の第Ⅱ誘導心電図波形を図に示す。\n心室筋の再分極を示すのはどれか。1つ選べ。",
