        {
          "question": "内因の定義は？",
          "answer": "個体の内部にある病気の原因"
        },
        {
          "question": "内因の本体は？",
          "answer": "遺伝子"
        },
        {
          "question": "素因の定義は？",
          "answer": "病気にかかりやすい素質"
        },
        {
          "question": "一般的素因の例は？",
          "answer": "年齢、性別、人種、臓器"
