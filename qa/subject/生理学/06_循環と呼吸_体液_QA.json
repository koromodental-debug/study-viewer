    {
      "section": "容量調節系（体液量の調節）",
      "qa": [
        {
          "question": "体液量低下時に活性化される系は？",
          "answer": "レニン-アンジオテンシン-アルドステロン系"
        },
        {
          "question": "アンジオテンシンIIの作用は？",
          "answer": "血管収縮、アルドステロン分泌促進"
        },
        {
          "question": "アルドステロンの作用は？",
          "answer": "遠位尿細管・集合管でNa⁺再吸収促進→体液量増加"
        }
      ]
    },
    {
      "section": "体液量増加での調節系",
      "qa": [
        {
          "question": "体液量増加時に分泌されるペプチドは？",
          "answer": "心房性Na利尿ペプチド（ANP）"
        },
        {
          "question": "ANPの作用は？",
          "answer": "Na⁺再吸収抑制（アルドステロン作用を抑制）→体液量低下"
        }
      ]
    },
    {
      "section": "浸透圧調節系",
      "qa": [
        {
          "question": "水の再吸収を促進するホルモンは？",
          "answer": "バソプレシン（ADH：抗利尿ホルモン）"
        },
        {
          "question": "バソプレシンが産生される部位は？",
          "answer": "視床下部"
        },
        {
          "question": "バソプレシンが分泌される部位は？",
          "answer": "下垂体後葉"
        },
        {
          "question": "バソプレシンの作用部位は？",
          "answer": "遠位尿細管・集合管"
        }
      ]
    },
    {
      "section": "遠位尿細管・集合管に作用するホルモン",
      "qa": [
        {
          "question": "遠位尿細管でCa²⁺再吸収を促進するホルモンは？",
          "answer": "パラトルモン（PTH）"
        },
        {
          "question": "アルドステロンとANP、作用が拮抗するのはどの点？",
          "answer": "Na⁺再吸収（アルドステロン:促進、ANP:抑制）"
        }
      ]
    }
