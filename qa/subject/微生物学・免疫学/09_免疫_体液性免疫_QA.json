    {
      "section": "体液性免疫とは",
      "qa": [
        {
          "question": "体液性免疫を担う主な細胞は？",
          "answer": "B細胞（形質細胞に分化して抗体を産生）"
        },
        {
          "question": "体液性免疫を構成する細胞は？",
          "answer": "B細胞、好中球、マクロファージ"
        },
        {
          "question": "抗体の主な機能は？",
          "answer": "中和、オプソニン化、補体活性化"
        }
      ]
    },
    {
      "section": "抗体（免疫グロブリン）の構造",
      "qa": [
        {
          "question": "抗体の基本構造は？",
          "answer": "H鎖（重鎖）2本とL鎖（軽鎖）2本からなるY字型構造"
        },
        {
          "question": "Fab領域の機能は？",
          "answer": "抗原結合部位（可変領域を含む）"
        },
        {
          "question": "Fc領域の機能は？",
          "answer": "食細胞結合部位（定常領域）、補体活性化"
        },
        {
          "question": "パパインで抗体を切断するとどうなるか？",
          "answer": "Fab×2 + Fc（ヒンジ部より上で切断）"
        },
        {
          "question": "ペプシンで抗体を切断するとどうなるか？",
          "answer": "F(ab')₂ + Fc断片（ヒンジ部より下で切断）"
        }
      ]
    },
    {
      "section": "Fab vs Fc（対比）",
      "qa": [
        {
          "question": "FabとFc、抗原と結合するのは？",
          "answer": "Fab"
        },
        {
          "question": "FabとFc、食細胞と結合するのは？",
          "answer": "Fc"
        },
        {
          "question": "FabとFc、可変領域を含むのは？",
          "answer": "Fab"
        },
        {
          "question": "FabとFc、定常領域のみなのは？",
          "answer": "Fc"
        }
      ]
    },
    {
      "section": "免疫グロブリンの種類と結合価",
      "qa": [
        {
          "question": "ヒトの免疫グロブリンは何種類か？",
          "answer": "5種類（IgG、IgM、IgA、IgE、IgD）"
        },
        {
          "question": "IgGの構造と結合価は？",
          "answer": "単量体、2価"
        },
        {
          "question": "IgMの構造と結合価は？",
          "answer": "五量体、10価"
        },
        {
          "question": "IgA（分泌型）の構造と結合価は？",
          "answer": "二量体、4価"
        },
        {
          "question": "IgEの構造と結合価は？",
          "answer": "単量体、2価"
        },
        {
          "question": "結合価の計算方法は？",
          "answer": "単量体＝2価、二量体＝4価（2×2）、五量体＝10価（2×5）"
        }
      ]
    },
    {
      "section": "IgG vs IgM vs sIgA（対比）【頻出】",
      "qa": [
        {
          "question": "IgGとIgM、血清中に最も多いのは？",
          "answer": "IgG（約75%）"
        },
        {
          "question": "IgGとIgM、最初に産生されるのは？",
          "answer": "IgM"
        },
        {
          "question": "IgGとIgM、胎盤を通過できるのは？",
          "answer": "IgG"
        },
        {
          "question": "IgGとsIgA、粘膜免疫の中心となるのは？",
          "answer": "sIgA"
        },
        {
          "question": "IgMとsIgA、結合価が高いのは？",
          "answer": "IgM（10価 vs 4価）"
        }
      ]
    },
