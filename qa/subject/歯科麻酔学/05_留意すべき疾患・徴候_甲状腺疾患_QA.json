        {
          "question": "歯科用リドカイン塩酸塩・アドレナリン配合局所麻酔薬の原則禁忌はどれか。すべて選べ。",
          "answer": "糖尿病 / 高血圧症 / 甲状腺機能亢進症",
          "choices": {
            "a": "糖尿病",
            "b": "高血圧症",
            "c": "慢性肝炎",
            "d": "十二指腸潰瘍",
            "e": "甲状腺機能亢進症"
          },
          "correctAnswer": "ABE",
          "numChoices": 1,
          "code": "104A101"
