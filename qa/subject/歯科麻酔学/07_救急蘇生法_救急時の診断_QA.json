    {
      "section": "触診できる動脈",
      "qa": [
        {
          "question": "歯科治療中の偶発症発生時において脈拍を触知するのに適切なのはどれか。2つ選べ。",
          "answer": "総頸動脈 / 橈骨動脈",
          "choices": {
            "a": "顔面動脈",
            "b": "総頸動脈",
            "c": "橈骨動脈",
            "d": "大腿動脈",
            "e": "足背動脈"
          },
          "correctAnswer": "BC",
          "numChoices": 2,
          "code": "105A99"
        }
      ]
    },
    {
      "section": "成人のBLSアルゴリズム",
      "qa": [
        {
          "question": "歯科医院の待合室で倒れている患者を発見した。呼びかけに反応しない。\nまず行うのはどれか。2つ選べ。",
          "answer": "AEDを手配する / 119番に通報する",
          "choices": {
            "a": "下肢を挙上する。",
            "b": "胸骨を圧迫する。",
            "c": "人工呼吸を行う。",
            "d": "AED を手配する。",
            "e": "119番に通報する。"
          },
          "correctAnswer": "DE",
          "numChoices": 2,
          "code": "112D44"
        }
      ]
    },
    {
      "section": "呼吸の有無による判断",
      "qa": [
        {
          "question": "83歳の男性。齲蝕治療を希望して来院した。糖尿病の既往がある。処置直前の血糖値は134mg/dLであった。生体モニタを装着後、齲蝕治療中に呂律が回らなくなり意識を失った。呼吸はあるが呼びかけに応答しないため救急対応システムに出動を要請した。このときの生体モニタの写真（別冊No.34）を別に示す。\n次に行うのはどれか。1つ選べ。",
          "answer": "回復体位の実施",
          "choices": {
            "a": "回復体位の実施",
            "b": "胸骨圧迫の実施",
            "c": "人工呼吸の実施",
            "d": "ブドウ糖の投与",
            "e": "アドレナリンの投与"
          },
          "correctAnswer": "A",
          "numChoices": 1,
          "code": "115A88"
        }
      ]
    },
