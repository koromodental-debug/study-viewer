      "qa": [
        {
          "question": "25歳の男性。埋伏した下顎右側第三大臼歯を抜去するために伝達麻酔を行うこととした。開口時の口腔内写真（別冊No.1）を別に示す。\n注射針の刺入部位で適切なのはどれか。1つ選べ。",
          "answer": "イ",
          "choices": {
            "a": "ア",
            "b": "イ",
            "c": "ウ",
            "d": "エ",
            "e": "オ"
          },
          "correctAnswer": "B",
          "numChoices": 1,
          "code": "104D1"
        }
      ]
