      "qa": [
        {
          "question": "25歳の男性。左側顎下部の腫脹を主訴として来院した。体温は39.0℃で、強い疼痛と開口障害とがある。昨日から食事をとっていないという。特記すべき既往歴はない。抗菌薬の点滴とともに輸液を行うこととした。\n投与すべき成分はどれか。2つ選べ。",
          "answer": "電解質 / ブドウ糖",
          "choices": {
            "a": "電解質",
            "b": "ブドウ糖",
            "c": "アミノ酸",
            "d": "ビタミン",
            "e": "アルブミン"
          },
          "correctAnswer": "AB",
          "numChoices": 2,
          "code": "102B33"
        }
      ]
