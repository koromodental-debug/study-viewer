      "qa": [
        {
          "question": "成人におけるI度高血圧（収縮期血圧/拡張期血圧(mmHg)）に分類されるのはどれか。1つ選べ。",
          "answer": "145/85",
          "choices": {
            "a": "114/74",
            "b": "125/74",
            "c": "135/79",
            "d": "145/85",
            "e": "165/90"
          },
          "correctAnswer": "D",
          "numChoices": 1,
          "code": "115C63"
        }
      ]
    },
    {
      "section": "左心不全 vs 右心不全",
      "qa": [
        {
          "question": "左心不全の症状はどれか。1つ選べ。",
          "answer": "起坐呼吸",
          "choices": {
            "a": "肝腫大",
            "b": "眼瞼浮腫",
            "c": "下腿浮腫",
            "d": "静脈怒張",
            "e": "起坐呼吸"
          },
          "correctAnswer": "E",
          "numChoices": 1,
          "code": "104C59"
        }
      ]
    },
    {
      "section": "なぜ頻脈を避けるか",
      "qa": [
        {
          "question": "狭心症を合併する患者の歯科治療で頻脈にさせない理由はどれか。1つ選べ。",
          "answer": "拡張期時間が短縮するため",
          "choices": {
            "a": "収縮期血圧が上昇するため",
            "b": "平均動脈圧が上昇するため",
            "c": "拡張期血圧が低下するため",
            "d": "収縮期時間が延長するため",
            "e": "拡張期時間が短縮するため"
          },
          "correctAnswer": "E",
          "numChoices": 1,
          "code": "102B89"
        }
      ]
    },
    {
      "section": "心房細動",
      "qa": [
        {
          "question": "心原性脳塞栓症の原因となる不整脈はどれか。1つ選べ。",
          "answer": "心房細動",
          "choices": {
            "a": "心室細動",
            "b": "心室頻拍",
            "c": "心房細動",
            "d": "上室性期外収縮",
            "e": "II度房室ブロック（Wenckebach型）"
          },
          "correctAnswer": "C",
          "numChoices": 1,
          "code": "115A62"
        }
      ]
    },
    {
      "section": "抗菌薬予防投与が必要な患者",
      "qa": [
        {
          "question": "既往歴と歯科治療時の対応の組合せで正しいのはどれか。1つ選べ。",
          "answer": "人工弁置換術後 ――― 抗菌薬予防投与下での抜歯",
          "choices": {
            "a": "腎不全 ――― カリウムの補液",
            "b": "脳血管障害 ――― 麻痺側での血圧測定",
            "c": "人工弁置換術後 ――― 抗菌薬予防投与下での抜歯",
            "d": "抗血小板薬服用 ――― 服用を中止して抜歯",
            "e": "ペースメーカ植込み ――― 電気メスの使用"
          },
          "correctAnswer": "C",
          "numChoices": 1,
          "code": "109C56"
        }
      ]
    },
