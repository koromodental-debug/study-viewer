  "sections": [
    {
      "section": "ASA-PS分類（6段階）",
      "qa": [
        {
          "question": "本態性高血圧症と診断されているが、安静時血圧のコントロールは良好で日常生活に制限はない。\nこの患者の米国麻酔科学会による術前状態分類〈ASA-PS〉はどれか。1つ選べ。",
          "answer": "Ⅱ",
          "choices": {
            "a": "Ⅰ",
            "b": "Ⅱ",
            "c": "Ⅲ",
            "d": "Ⅳ",
            "e": "Ⅴ"
          },
          "correctAnswer": "B",
          "numChoices": 1,
          "code": "114B72"
        }
      ]
    },
