  "sections": [
    {
      "section": "判定基準",
      "qa": [
        {
          "question": "スパイロメトリで1秒率80%、%肺活量50%であった。考えられるのはどれか。1つ選べ。",
          "answer": "間質性肺炎",
          "choices": {
            "a": "喘息",
            "b": "間質性肺炎",
            "c": "気管支拡張症",
            "d": "慢性閉塞性肺疾患",
            "e": "睡眠時無呼吸症候群"
          },
          "correctAnswer": "B",
          "numChoices": 1,
          "code": "111D30"
        }
      ]
    },
    {
      "section": "症状・所見",
      "qa": [
        {
          "question": "慢性閉塞性肺疾患患者にみられるのはどれか。2つ選べ。",
          "answer": "息切れ / 気道抵抗増加",
          "choices": {
            "a": "息切れ",
            "b": "起坐呼吸",
            "c": "PaO2の上昇",
            "d": "気道抵抗増加",
            "e": "胸郭コンプライアンス増加"
          },
          "correctAnswer": "AD",
          "numChoices": 2,
          "code": "108A71"
        },
        {
          "question": "肺コンプライアンスが高くなるのはどれか。1つ選べ。",
          "answer": "肺気腫",
          "choices": {
            "a": "肺気腫",
            "b": "肺水腫",
            "c": "肺線維症",
            "d": "間質性肺炎",
            "e": "気管支喘息"
          },
          "correctAnswer": "A",
          "numChoices": 1,
          "code": "116A74"
        }
      ]
    },
    {
      "section": "在宅酸素療法（HOT）",
      "qa": [
        {
          "question": "在宅酸素療法で酸素1L/分を鼻カニューレから投与した際の吸入酸素濃度はどれか。1つ選べ。",
          "answer": "約24%",
          "choices": {
            "a": "約20%",
            "b": "約24%",
            "c": "約32%",
            "d": "約40%",
            "e": "約50%"
          },
          "correctAnswer": "B",
          "numChoices": 1,
          "code": "115A44"
        }
      ]
    },
    {
      "section": "歯科治療時の注意点",
      "qa": [
        {
          "question": "26歳の男性。下顎右側臼歯部の腫れを主訴として来院した。気管支喘息の既往がある。診察の結果、智歯周囲炎と診断し、全身麻酔下において抜歯した。術後創部痛のためロキソプロフェンナトリウム水和物を内服させたところ、次第に著明な咳嗽と喘鳴が生じた。呼吸困難のためサルブタモール硫酸塩の吸入ができなかった。この時の生体情報モニタ画面の写真（別冊No.4）を別に示す。次に投与するのはどれか。2つ選べ。",
          "answer": "酸素 / アドレナリン",
          "choices": {
            "a": "酸素",
            "b": "アドレナリン",
            "c": "ニトログリセリン",
            "d": "ランジオロール塩酸塩",
            "e": "チオペンタールナトリウム"
          },
          "correctAnswer": "AB",
          "numChoices": 2,
          "code": "115C28"
        },
        {
          "question": "呼吸機能障害の重症度を評価するための指標はどれか。1つ選べ。",
          "answer": "Hugh-Jones分類",
          "choices": {
            "a": "ASA-PS分類",
            "b": "FAST分類",
            "c": "Hugh-Jones分類",
            "d": "NYHA分類",
            "e": "TNM分類"
          },
          "correctAnswer": "C",
          "numChoices": 1,
          "code": "113D40"
        }
      ]
    },
