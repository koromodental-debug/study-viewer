      "qa": [
        {
          "question": "局所麻酔薬中毒の初期症状はどれか。1つ選べ。",
          "answer": "興奮",
          "choices": {
            "a": "興奮",
            "b": "徐脈",
            "c": "意識消失",
            "d": "けいれん",
            "e": "チアノーゼ"
