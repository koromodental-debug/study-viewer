      "qa": [
        {
          "question": "成人健常者の呼吸数は？",
          "answer": "12〜18回/分"
        },
        {
          "question": "新生児の呼吸数は？",
          "answer": "40〜60回/分"
        },
        {
          "question": "徐呼吸の定義は？",
          "answer": "12回/分未満"
        },
        {
          "question": "頻呼吸の定義は？",
          "answer": "24回/分以上"
        }
      ]
