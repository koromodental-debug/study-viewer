  "sections": [
    {
      "section": "呼吸の種類",
      "qa": [
        {
          "question": "腹式呼吸で主に働く筋は？",
          "answer": "横隔膜"
        },
        {
          "question": "胸式呼吸で主に働く筋は？",
          "answer": "外肋間筋"
        },
        {
          "question": "肺自体に収縮能力はある？",
          "answer": "ない（呼吸筋の収縮で胸郭内の容積を変化させて呼吸する）"
        }
      ]
    },
    {
      "section": "吸気筋（吸息筋）",
      "qa": [
        {
          "question": "最も主要な吸気筋は？",
          "answer": "横隔膜"
        },
        {
          "question": "横隔膜の作用は？",
          "answer": "胸郭の垂直方向の距離を増大"
        },
        {
          "question": "外肋間筋の作用は？",
          "answer": "肋骨を挙上・前方移動させ、胸郭の横径・前後径を拡大"
        },
        {
          "question": "補助吸気筋の例を2つ挙げると？",
          "answer": "斜角筋、胸鎖乳突筋"
        }
      ]
    },
    {
      "section": "呼気筋（呼息筋）",
      "qa": [
        {
          "question": "呼気筋に含まれる肋間筋は？",
          "answer": "内肋間筋\n\n[混同注意] 外肋間筋は吸気筋"
        },
        {
          "question": "腹筋群に含まれる筋の代表は？",
          "answer": "腹直筋、外腹斜筋"
        },
        {
          "question": "腹筋群は吸気筋・呼気筋のどちら？",
          "answer": "呼気筋"
        }
      ]
    },
    {
      "section": "吸気（能動的）",
      "qa": [
        {
          "question": "吸気時、横隔膜・外肋間筋は収縮・弛緩のどちら？",
          "answer": "収縮"
        },
        {
          "question": "吸気時、胸腔内圧はどうなる？",
          "answer": "低下（陰圧になる）"
        },
        {
          "question": "吸気時、肺はどうなる？",
          "answer": "受動的に拡張"
        }
      ]
    },
    {
      "section": "呼気",
      "qa": [
        {
          "question": "安静時呼気は呼気筋を使う？",
          "answer": "使わない（胸郭・肺の弾性収縮による受動的な呼気）"
        },
        {
          "question": "努力性呼気で働く筋は？",
          "answer": "内肋間筋、腹筋群"
        },
        {
          "question": "安静時呼気と努力性呼気、能動的なのは？",
          "answer": "努力性呼気"
        }
      ]
    },
    {
