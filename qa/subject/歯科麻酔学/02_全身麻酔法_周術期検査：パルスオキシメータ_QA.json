        {
          "question": "モニター中の写真（別冊No.10）を別に示す。\n測定しているのはどれか。2つ選べ。",
          "answer": "脈拍、動脈血酸素飽和度",
          "choices": {
            "a": "血圧",
            "b": "脈拍",
            "c": "体温",
            "d": "動脈血酸素分圧",
            "e": "動脈血酸素飽和度"
          },
          "correctAnswer": "BE",
          "numChoices": 2,
          "code": "103C129"
        }
      ]
    },
