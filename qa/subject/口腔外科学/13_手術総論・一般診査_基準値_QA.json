{
  "metadata": {
    "title": "基準値",
    "category": "口腔外科学",
    "chapter": "手術総論・一般診査"
  },
  "sections": [
    {
      "section": "血液一般検査の基準値",
      "qa": [
        {
          "question": "赤血球数（RBC）の基準値は？",
          "answer": "男 400〜540×10^4/μl、女 380〜490×10^4/μl。低値→貧血、高値→多血症"
        },
        {
          "question": "Hb（ヘモグロビン）の基準値は？",
          "answer": "男 14〜18 g/dl、女 12〜16 g/dl。低値→貧血"
        },
        {
          "question": "Ht（ヘマトクリット）の基準値は？",
          "answer": "男 36〜49%、女 34〜44%。低値→貧血、高値→脱水・多血症"
        },
        {
          "question": "Ht 30%は正常か異常か？",
          "answer": "異常低値。男女とも基準値以下であり、貧血を意味する"
        },
        {
          "question": "白血球数（WBC）の基準値は？",
          "answer": "5,000〜8,500/μl。高値→感染・炎症、低値→免疫低下"
        },
        {
          "question": "血小板数（Plt）の基準値は？",
          "answer": "13〜35×10^4/μl。低値→出血傾向。8万以下で観血処置注意"
        },
        {
          "question": "血小板 50,000/μl（5万）は正常か異常か？",
          "answer": "異常低値。基準値13〜35万の範囲外で著明低値"
        }
      ]
    },
    {
      "section": "凝固系検査の基準値",
      "qa": [
        {
          "question": "PT（プロトロンビン時間）の基準値と延長する場合は？",
          "answer": "10〜13秒。外因系異常（肝硬変、VitK欠乏）で延長"
        },
        {
          "question": "APTTの基準値と延長する場合は？",
          "answer": "25〜40秒。内因系異常（血友病）で延長"
        },
        {
          "question": "出血時間（Ivy法）の基準値と延長する場合は？",
          "answer": "2〜5分。血小板異常、血管壁異常で延長"
        }
      ]
    },
    {
      "section": "生化学検査の基準値：肝機能",
      "qa": [
        {
          "question": "AST（GOT）の基準値と高値の意味は？",
          "answer": "10〜40 IU/L。高値→肝障害、心筋梗塞、筋疾患"
        },
        {
          "question": "AST 20 IU/Lは正常か異常か？",
          "answer": "正常。基準値10〜40 IU/Lの範囲内"
        },
        {
          "question": "ALT（GPT）の基準値と高値の意味は？",
          "answer": "5〜40 IU/L。高値→肝障害（肝特異性が高い）"
        },
        {
          "question": "γ-GTPの基準値と高値の意味は？",
          "answer": "男 70 IU/L以下、女 30 IU/L以下。高値→アルコール性肝障害、胆汁うっ滞"
        },
        {
          "question": "ALPの基準値と高値の意味は？",
          "answer": "100〜340 IU/L。高値→胆汁うっ滞、骨疾患"
        },
        {
          "question": "LDH（LD）の基準値と高値の意味は？",
          "answer": "120〜240 IU/L。高値→組織破壊（非特異的）"
        },
        {
          "question": "総ビリルビン（T-Bil）の基準値と高値の意味は？",
          "answer": "0.2〜1.2 mg/dl。高値→黄疸（肝障害、溶血、胆道閉塞）"
        },
        {
          "question": "総ビリルビン 1.0 mg/dlは正常か異常か？",
          "answer": "正常。基準値0.2〜1.2 mg/dlの範囲内"
        },
        {
          "question": "総タンパク（TP）の基準値と異常の意味は？",
          "answer": "6.5〜8.0 g/dl。高値→脱水・多発性骨髄腫、低値→肝障害・ネフローゼ"
        },
        {
          "question": "TP 7.2 g/dlは正常か異常か？",
          "answer": "正常。基準値6.5〜8.0 g/dlの範囲内"
        },
        {
          "question": "アルブミン（Alb）の基準値と低値の意味は？",
          "answer": "3.8〜5.3 g/dl。低値→肝障害・栄養不良"
        }
      ]
    },
    {
      "section": "生化学検査の基準値：腎機能",
      "qa": [
        {
          "question": "クレアチニン（Cr）の基準値と高値の意味は？",
          "answer": "男 0.6〜1.1 mg/dl、女 0.4〜0.8 mg/dl。高値→腎機能低下"
        },
        {
          "question": "Cr 2.0 mg/dlは正常か異常か？",
          "answer": "異常高値。基準上限の約2倍であり、腎機能低下を意味する"
        },
        {
          "question": "Cr 5.0 mg/dlは正常か異常か？",
          "answer": "明らかな異常高値。基準上限の約5倍であり、重度の腎機能低下を意味する"
        },
        {
          "question": "BUN（尿素窒素）の基準値と高値の意味は？",
          "answer": "8〜20 mg/dl。高値→腎機能低下・脱水・消化管出血"
        },
        {
          "question": "BUN 20 mg/dlは正常か異常か？",
          "answer": "正常範囲内。基準値上限ギリギリだが範囲内である"
        },
        {
          "question": "尿酸（UA）の基準値と高値の意味は？",
          "answer": "男 3.0〜7.0 mg/dl、女 2.5〜7.0 mg/dl。高値→痛風、腎障害"
        },
        {
          "question": "eGFRの基準値と低値の意味は？",
          "answer": "90 ml/min/1.73m^2以上。低値→CKD（60未満でG3以上）"
        },
        {
          "question": "Cr高値が腎機能低下を示す理由は？",
          "answer": "クレアチニンはGFR低下により排泄されなくなるため、血中濃度が上昇する"
        }
      ]
    },
    {
      "section": "電解質の基準値",
      "qa": [
        {
          "question": "K（カリウム）の基準値と異常の意味は？",
          "answer": "3.5〜5.0 mEq/L。高値→不整脈（心停止）、低値→筋力低下"
        },
        {
          "question": "K 4.1 mEq/Lは正常か異常か？",
          "answer": "正常。基準値3.5〜5.0 mEq/Lの範囲内"
        },
        {
          "question": "Na（ナトリウム）の基準値と異常の意味は？",
          "answer": "135〜147 mEq/L。低値→意識障害、高値→脱水"
        },
        {
          "question": "Cl（クロール）の基準値と異常の意味は？",
          "answer": "98〜108 mEq/L。Naと連動して変動"
        },
        {
          "question": "Ca（カルシウム）の基準値と異常の意味は？",
          "answer": "8.4〜10.4 mg/dl。低値→テタニー、高値→悪性腫瘍"
        }
      ]
    },
    {
      "section": "糖代謝・脂質の基準値",
      "qa": [
        {
          "question": "空腹時血糖の基準値と異常の意味は？",
          "answer": "70〜109 mg/dl。110〜125→境界型、126以上→糖尿病型"
        },
        {
          "question": "空腹時血糖 90 mg/dlは正常か異常か？",
          "answer": "正常。基準値70〜109 mg/dlの範囲内"
        },
        {
          "question": "HbA1cの基準値と異常の意味は？",
          "answer": "4.6〜6.2%。6.5%以上→糖尿病"
        },
        {
          "question": "総コレステロールの基準値は？",
          "answer": "220 mg/dl未満。高値→動脈硬化リスク"
        },
        {
          "question": "TG（トリグリセリド）の基準値は？",
          "answer": "150 mg/dl未満。高値→脂質異常症"
        },
        {
          "question": "HDLコレステロールの基準値は？",
          "answer": "40 mg/dl以上。低値→冠動脈疾患リスク"
        },
        {
          "question": "LDLコレステロールの基準値は？",
          "answer": "140 mg/dl未満。高値→動脈硬化リスク"
        }
      ]
    },
    {
      "section": "その他の基準値",
      "qa": [
        {
          "question": "CRPの基準値は？",
          "answer": "0.3 mg/dl以下"
        },
        {
          "question": "赤沈（ESR）の基準値は？",
          "answer": "男 2〜10 mm/h、女 3〜15 mm/h"
        },
        {
          "question": "TTTの基準値は？",
          "answer": "1.5〜7.0 単位"
        },
        {
          "question": "ZTTの基準値は？",
          "answer": "4〜12 単位"
        },
        {
          "question": "アミラーゼの基準値は？",
          "answer": "40〜120 IU/L"
        }
      ]
    },
    {
      "section": "過去問",
